{
  "manifest_version": 3,
  "name": "WebToEpubFix",
  "version": "1.0.14.66",
  "description": "Independent WebToEpub fork with Patreon, Royal Road, and Pawchive parser fixes.",
  "default_locale": "en",
  "icons": {
    "128": "book128.png"
  },
  "permissions": [
    "cookies",
    "downloads",
    "webRequest",
    "declarativeNetRequest",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "browser_style": false,
    "default_title": "",
    "default_icon": "book128.png",
    "default_popup": "popup.html"
  },
  "incognito": "split",
  "browser_specific_settings": {
    "gecko": {
      "id": "WebToEpubFix@Cavad.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "id": "WebToEpubFix@Cavad.github.io",
      "strict_min_version": "142.0"
    }
  },
  "minimum_chrome_version": "120"
}
